[Unit]
Description=Literary Survival Classroom
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/literary-survival
ExecStart=/opt/dino-node/bin/node /opt/literary-survival/server.cjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/literary-survival

[Install]
WantedBy=multi-user.target
